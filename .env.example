# Copie para .env.local (ignorado pelo Git). Toda variável VITE_* é PÚBLICA: nunca coloque segredos aqui.

# URL da API REST (padrão: json-server local)
VITE_API_URL=http://localhost:3001

# "true" usa o modo demonstração (dados no localStorage do navegador, sem API) — usado no deploy
VITE_DEMO=false
